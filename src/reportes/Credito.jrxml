	<queryString>
		<![CDATA[select f.*, c.nombre, c.direccion, c.telefono, c.cedula, co.direccion as dir, co.telefono as tel1, co.telefono_2 as tel2
from facturas f, contactos c, configuraciones co
where f.id_contacto=c.id and f.id=$P{id_factura}]]>
	</queryString>
