	<parameter name="id_factura" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select rc.id as id_f, rc.fecha, c.id as id_c, c.cedula, c.nombre, c.direccion, c.contacto, rd.codigo
from recortes_cabecera rc,contactos c, recortes_detalle rd
where rd.id_contacto=c.id and rd.id=$P{id_factura} and rd.id_cabecera=rc.id]]>
	</queryString>
