	<parameter name="id_factura" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select f.cantidad, f.observacion, max(c.pie_legal) as pie_legal
from recortes_detalle f, recortes_cabecera fc, configuraciones c
where f.id_cabecera=fc.id and f.id = $P{id_factura} group by fc.observacion,f.cantidad, f.observacion]]>
	</queryString>
	<field name="cantidad" class="java.lang.Double"/>
	<field name="observacion" class="java.lang.String"/>
	<field name="pie_legal" class="java.lang.String"/>
