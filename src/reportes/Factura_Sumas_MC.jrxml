	<queryString>
		<![CDATA[select sum(f.cantidad), fc.observacion, max(c.pie_legal) as pie_legal from facturas_detalles f, facturas_cabeceras fc, configuraciones c where f.id_cabecera=fc.id and f.id_cabecera = $P{id_factura} group by fc.observacion]]>
