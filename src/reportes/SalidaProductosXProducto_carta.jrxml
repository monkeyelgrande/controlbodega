	<queryString>
		<![CDATA[select fc.id as id_factura, fc.fecha, c.nombre as contacto, fd.cantidad, p.codigo_barras, p.descripcion from facturas_detalles fd, facturas_cabeceras fc, productos p, contactos c where fd.id_cabecera=fc.id and fd.id_producto=p.id and fc.id_contacto=c.id and fd.id_producto=$P{codigo} and fc.anulado=1 and fc.fecha between $P{fecha1} and $P{fecha2} order by fc.fecha ]]>
	</queryString>
